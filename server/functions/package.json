    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "nodemailer": "^6.9.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
